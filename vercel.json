{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/volvo-cars-app/browser"
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/" }],
  "buildCommand": "npm run build",
  "outputDirectory": "dist/volvo-cars-app/browser",
  "installCommand": "npm install"
}
